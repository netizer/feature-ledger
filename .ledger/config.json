{
  "product": "feature-ledger",
  "tagline": "",
  "prepared_for": "the client",
  "categories": [
    "Setting up a ledger",
    "Recording what the product does",
    "Reading the ledger",
    "The documents it produces"
  ],
  "default_category": "Features",
  "style": "google",
  "output": {
    "dir": "docs/generated",
    "client_dir": "docs/client",
    "pdf_name": "{slug}-Feature-Ledger_{version}.pdf",
    "features": "FEATURES.md",
    "extended": "FEATURES_EXTENDED.md",
    "dev": "DEV_FEATURES.md"
  },
  "docs": {},
  "schema": 2,
  "ignore": [
    "test/**",
    "tests/**",
    "spec/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.*",
    ".github/**",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "LICENSE*",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "Gemfile.lock",
    "poetry.lock",
    "Cargo.lock",
    "go.sum",
    "README*",
    "CHANGELOG*",
    "CLAUDE.md",
    "AGENTS.md",
    "GEMINI.md",
    ".cursor/**",
    ".windsurfrules",
    ".claude/**",
    "docs/**",
    "examples/**",
    "package.json",
    "bin/**",
    "src/cli.mjs",
    "src/util.mjs",
    "src/ui.mjs"
  ]
