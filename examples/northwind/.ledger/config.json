{
  "product": "Northwind Portal",
  "tagline": "",
  "prepared_for": "the client",
  "categories": [
    "Ordering",
    "Account & Self-Service",
    "Warehouse Console",
    "Platform & Reliability"
  ],
  "min_subcategory_features": 4,
  "output": {
    "dir": "docs/generated",
    "client_dir": "docs/generated/client",
    "pdf_name": "{slug}-Feature-Ledger_{version}.pdf",
    "features": "FEATURES.md",
    "extended": "FEATURES_EXTENDED.md",
    "dev": "DEV_FEATURES.md"
  },
  "docs": {},
  "schema": 2,
  "ignore": [
    "test/**",
    "tests/**",
    "spec/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.*",
    ".github/**",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "LICENSE*",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "Gemfile.lock",
    "poetry.lock",
    "Cargo.lock",
    "go.sum",
    "README*",
    "CHANGELOG*",
    "CLAUDE.md",
    "AGENTS.md",
    "GEMINI.md",
    ".cursor/**",
    ".windsurfrules",
    ".claude/**"
  ]
}
